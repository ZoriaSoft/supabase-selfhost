# Path A — GoTrue standalone env (no Docker).
# Copy to gotrue.env, fill in, chmod 600. Never commit real secrets.
# See SECURITY.md "If you run GoTrue standalone".

# --- API bind (loopback only in production; put TLS proxy in front) ---
GOTRUE_API_HOST=127.0.0.1
GOTRUE_API_PORT=9999

# --- Postgres (dedicated role recommended: supabase_auth_admin) ---
# Example (edit host/db/password):
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:CHANGE_ME@127.0.0.1:5432/postgres

# --- JWT (master key — anyone holding it can mint admin tokens) ---
GOTRUE_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_EXP=3600
# Public issuer URL clients will see (usually your HTTPS proxy origin + /auth/v1)
GOTRUE_JWT_ISSUER=https://auth.example.com/auth/v1

# --- Public URLs for mailer / redirects ---
GOTRUE_SITE_URL=https://app.example.com
API_EXTERNAL_URL=https://auth.example.com/auth/v1
GOTRUE_URI_ALLOW_LIST=
GOTRUE_DISABLE_SIGNUP=false

# --- Email auth (dev: autoconfirm; prod: real SMTP + autoconfirm=false) ---
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
# GOTRUE_SMTP_HOST=
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=
# GOTRUE_SMTP_PASS=
# GOTRUE_SMTP_ADMIN_EMAIL=noreply@example.com
# GOTRUE_SMTP_SENDER_NAME=Auth
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Phone auth off by default for Path A
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_SMS_AUTOCONFIRM=false
